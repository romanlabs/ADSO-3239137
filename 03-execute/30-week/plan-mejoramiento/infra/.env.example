# Copy to infra/.env and replace every value. infra/.env is ignored by git.
DB_PASSWORD=change-me
# php artisan key:generate --show (inside the api container) prints a valid key
APP_KEY=base64:replace-with-a-generated-key
# At least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
CORS_ORIGIN=http://localhost:5173
CLOCK_OFFSET_DAYS=0
# Origin of the API as the browser sees it; baked into the app at build time (the client adds /api/v1)
VITE_API_URL=http://localhost:8000
